{
	"name": "@alsevilla/pi-engineering-harness",
	"version": "1.20.1",
	"description": "Engineering harness for Pi: subagent roles, ask-user and engineering skills.",
	"license": "MIT",
	"engines": {
		"node": ">=22.19.0"
	},
	"scripts": {
		"test": "node scripts/run-node-tests.mjs",
		"test:list": "node scripts/run-node-tests.mjs --list",
		"simulate:pi": "node scripts/simulate-pi-shaping.mjs",
		"simulate:main": "node --experimental-strip-types --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/simulate-main-sessions.mjs",
		"simulate:delegation": "node --experimental-strip-types --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/simulate-delegation.mjs",
		"simulate:delegation:openai": "node --experimental-strip-types --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/simulate-delegation.mjs --openai",
		"simulate:claude": "node --experimental-strip-types --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/simulate-openai-shaping.mjs --anthropic",
		"simulate:openai": "node --experimental-strip-types --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/simulate-openai-shaping.mjs"
	},
	"pi": {
		"extensions": [
			"./agent/extensions/subagent/index.ts",
			"./agent/extensions/ask-user/index.ts"
		],
		"skills": [
			"./agent/skills/engineering-harness",
			"./agent/skills/agent-creation"
		],
		"prompts": [
			"./agent/prompts/learn.md"
		]
	},
	"peerDependencies": {
		"@earendil-works/pi-agent-core": "*",
		"@earendil-works/pi-ai": "*",
		"@earendil-works/pi-coding-agent": "*",
		"@earendil-works/pi-tui": "*",
		"typebox": "*"
	}
}
