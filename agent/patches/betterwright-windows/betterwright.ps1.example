# Use installed package source so Windows background-process fixes apply.
if ($MyInvocation.ExpectingInput) {
    $input | & "$HOME/.bun/bin/bun.exe" "$HOME/.bun/install/global/node_modules/betterwright/dist/bin/betterwright.js" @args
} else {
    & "$HOME/.bun/bin/bun.exe" "$HOME/.bun/install/global/node_modules/betterwright/dist/bin/betterwright.js" @args
}
exit $LASTEXITCODE
